#include <iostream>
#include <string>
using namespace std;


class Service {
protected:
    string serviceType; 
public:
    Service(string type) {
        serviceType = type;
    }
};


class Electricity : public Service {
private:
    int unit;
    double rates;

public:
    
    Electricity() : Service("Electricity Bill") {
        unit = 100;
        rates = 5.0;
    }

  
    void displayy() {
        double total_bill = unit * rates;
        cout << "--- " << serviceType << " ---" << endl;
        cout << "Units Consumed: " << unit << endl;
        cout << "Rate per Unit: Rs. " << rates << endl;
        cout << "Total Bill Amount: Rs. " << total_bill << endl;
    }
};


class Recharge : public Service {
private:
    string numbers;
    double amount;

public:
    
    Recharge(string num = "9876543210") : Service("Mobile Recharge") {
        numbers = num;
        amount = 199;
    }

    // Function to display details
    void display() {
        cout << "\n--- " << serviceType << " ---" << endl;
        cout << "Mobile Number: " << numbers << endl;
        cout << "Recharge Amount: Rs. " << amount << endl;
    }
};

int main() {

    Electricity electricBill;
    electricBill.displayy();

    Recharge mobileRecharge;
    mobileRecharge.display();

    return 0;
}
